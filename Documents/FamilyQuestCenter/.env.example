# Local development: development | Production hosting: production
FAMILY_QUEST_ENV=development
FAMILY_QUEST_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
FAMILY_QUEST_DATABASE_PATH=chorce.db
FAMILY_QUEST_SESSION_SECONDS=3600
FAMILY_QUEST_DEBUG=0

# Registration modes: local, closed, open, trial
# Production defaults to closed unless explicitly changed.
FAMILY_QUEST_REGISTRATION_MODE=local

# Hosted outbound email through Google Workspace SMTP.
# Never commit the real Google App Password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=christopher.gray@familyquestcenter.com
MAIL_PASSWORD=replace-with-google-app-password
MAIL_FROM=Family Quest Center <christopher.gray@familyquestcenter.com>
MAIL_TIMEOUT=20
APP_URL=https://replace-with-your-staging-url

# Stripe Billing test mode
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENFORCE_SUBSCRIPTIONS=false
SUBSCRIPTION_GRACE_DAYS=7
